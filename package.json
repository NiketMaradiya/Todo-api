{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "Todo API with authentication, email integration, password reset, assignments, comments, notifications, attachments, soft delete, restore, audit logs, database indexing, query optimization and Swagger API documentation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:auth": "jest tests/auth.test.js --runInBand --forceExit",
    "test:todo": "jest tests/todo.test.js --runInBand --forceExit",
    "test:admin": "jest tests/admin.test.js --runInBand --forceExit",
    "test:audit": "jest tests/todoActivity.test.js --runInBand --forceExit",
    "test:admin-audit": "jest tests/adminActivity.test.js --runInBand --forceExit",
    "test:attachment": "jest tests/todoAttachmentActivity.test.js --runInBand --forceExit",
    "test:all": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}